  sale               Sale?                  @relation("SaleOrder")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  confirmationToken     String? @unique
  confirmationTokenUsed Boolean @default(false)

  @@unique([tenantId, id])
  @@unique([tenantId, publicId])
  @@index([tenantId])
  @@index([tenantId, customerId])
  @@index([tenantId, customerPhoneNormalized])
  @@index([tenantId, readAt])
}

enum BlacklistType {
  PHONE
  CUSTOMER
  IP
}

// Fraud prevention: entries here block matching public checkouts (see OrdersService.createPublicOrder).
