}

enum ShipmentProvider {
  MAYSTRO
  YALIDINE
  ECOTRACK
  ZR_EXPRESS
  SELF
  LEOPARDS
  TCS
  MNP
  TRAX
  POSTEX
}

enum ShipmentStatus {
  DRAFT
  PENDING
  REQUESTED
  CONFIRMED
  IN_TRANSIT
  DELIVERED
  CANCELLED
  RETURNED
}

enum MaystroSyncStatus {
  PENDING
  SYNCED
  ERROR
}

model MaystroProductMapping {
  id             String  @id @default(uuid())
  tenantId       String
  tenant         Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  localProductId String
  product        Product @relation(fields: [tenantId, localProductId], references: [tenantId, id], onDelete: Cascade)

  /// The variant this remote product stands for, or "" when the product carries no
  /// attributes. Maystro shows an order's product name from the catalog's
  /// logistical_description and ignores whatever the order line says, so a variant
  /// only reaches the picker by name if it owns a remote product. Empty string
  /// rather than null keeps the compound unique usable with findUnique.
  localVariantId String @default("")

  maystroProductId String
  maystroUuid      String?

  syncStatus   MaystroSyncStatus @default(PENDING)
  lastSyncedAt DateTime?
  lastError    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, localProductId, localVariantId])
  @@unique([tenantId, maystroProductId])
  @@index([tenantId])
}

model MaystroOrderMapping {
  id           String @id @default(uuid())
  tenantId     String
  tenant       Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  localOrderId String
  order        Order  @relation(fields: [tenantId, localOrderId], references: [tenantId, id], onDelete: Cascade)

  externalId     String
  maystroOrderId String?
  tracking       String?
  deliveryPrice  Decimal?
  success        Boolean  @default(false)

  lastSyncedAt DateTime?
  lastError    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, localOrderId])
  @@unique([tenantId, externalId])
  @@index([tenantId])
}

model MaystroInventoryEvent {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  maystroProductId String?
  direction        String?
  quantity         Int?
  rawPayload       Json

  createdAt DateTime @default(now())

  @@index([tenantId])
  @@index([tenantId, createdAt])
}

/// Carrier-published prices per wilaya, cached so the admin pricing table doesn't
/// re-quote the carrier on every visit. Building one table costs 58 API calls, and
/// Yalidine answers that burst with 403 — see DeliveryService.getProviderLiveRatesByWilaya.
/// Distinct from DeliveryRate, which holds the tenant's own override prices.
model DeliveryCarrierRateCache {
  id           String           @id @default(uuid())
  tenantId     String
  tenant       Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  provider     ShipmentProvider
  deliveryMode String
  serviceLevel String?
  /// [{ wilayaCode, carrierPrice, currency, serviceLevel }] as returned to the admin.
  rates        Json
  fetchedAt    DateTime         @default(now())
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@unique([tenantId, provider, deliveryMode])
  @@index([tenantId])
}

model DeliveryRate {
  id               String           @id @default(uuid())
  tenantId         String
  tenant           Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  provider         ShipmentProvider
  wilayaCode       String
  communeCode      String?
  serviceLevel     String?
  price            Decimal          @default(0)
  currency         String           @default("DZD")
  isActive         Boolean          @default(true)
  estimatedMinDays Int?
  estimatedMaxDays Int?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@unique([tenantId, provider, wilayaCode, communeCode, serviceLevel])
  @@index([tenantId])
}

model Shipment {
  id                 String           @id @default(uuid())
  tenantId           String
  tenant             Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  orderId            String
  order              Order            @relation(fields: [tenantId, orderId], references: [tenantId, id], onDelete: Cascade)
  provider           ShipmentProvider
  providerShipmentId String?
  status             ShipmentStatus   @default(PENDING)
  serviceLevel       String?
  price              Decimal?
  currency           String           @default("DZD")
  contactName        String
  contactPhone       String
  wilayaCode         String
  communeCode        String?
  addressLine1       String
  addressLine2       String?
  notes              String?
  labelUrl           String?
  trackingUrl        String?
  metadata           Json?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  events ShipmentEvent[]

  @@unique([tenantId, provider, orderId])
  @@unique([tenantId, id])
  @@index([tenantId])
  @@index([provider, tenantId])
}

model ShipmentEvent {
  id          String          @id @default(uuid())
  tenantId    String
  tenant      Tenant          @relation("TenantShipmentEvents", fields: [tenantId], references: [id], onDelete: Cascade)
  shipmentId  String
  shipment    Shipment        @relation(fields: [tenantId, shipmentId], references: [tenantId, id], onDelete: Cascade)
  status      ShipmentStatus?
  code        String?
  description String?
  details     Json?
  rawPayload  Json?
  eventTime   DateTime        @default(now())
  createdAt   DateTime        @default(now())

  @@index([tenantId])
  @@index([shipmentId])
}

model OrderItem {
  id        String  @id @default(uuid())
  tenantId  String
  tenant    Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  orderId   String
  order     Order   @relation(fields: [tenantId, orderId], references: [tenantId, id])
  productId String
  product   Product @relation(fields: [tenantId, productId], references: [tenantId, id])

  quantity         Int
  price            Float // Price at the time of order
  lineTotal        Float? // Total for this line after bundle pricing (if any)
  pricingBreakdown Json?

