  createdBy       User?   @relation(fields: [tenantId, createdByUserId], references: [tenantId, id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@unique([tenantId, type, value])
  @@index([tenantId, type])
  @@index([tenantId, customerId])
}

model Customer {
  id       String @id @default(uuid())
