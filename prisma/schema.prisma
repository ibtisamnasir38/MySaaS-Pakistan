generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id              String    @id @default(uuid())
  slug            String    @unique
  name            String
  /// Offline-only is now a deliberate choice, not the birth state. Every
  /// self-registered tenant starts on an online trial; a super admin puts a
  /// tenant on the offline-only tier explicitly.
  isOffline       Boolean   @default(false)
  isSuspended     Boolean   @default(false)
  maintenanceMode Boolean   @default(false)
  archivedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  users                     User[]
  staffRoles                TenantStaffRole[]
  staffRolePermissions      TenantStaffRolePermission[]
  customers                 Customer[]
  customerPointsLedger      CustomerPointsLedger[]
  customerPayments          CustomerPayment[]
  cashboxes                 Cashbox[]
  cashSessions              CashSession[]
  cashTransactions          CashTransaction[]
  subscription              TenantSubscription?
  payments                  BillingPayment[]
  products                  Product[]
  productBundleDeals        ProductBundleDeal[]
  productImages             ProductImage[]
  productOptions            ProductOption[]
  optionValues              ProductOptionValue[]
  variants                  ProductVariant[]
  variantValues             ProductVariantOptionValue[]
  variantImages             ProductVariantImage[]
  inventoryMoves            InventoryMovement[]
  suppliers                 Supplier[]
  supplierPayments          SupplierPayment[]
  purchaseOrders            PurchaseOrder[]
  purchaseOrderItems        PurchaseOrderItem[]
  categories                Category[]
  productCategories         ProductCategory[]
  orders                    Order[]
  orderItems                OrderItem[]
  sales                     Sale[]
  saleItems                 SaleItem[]
  salesInvoices             SalesInvoice[]
  shipments                 Shipment[]
  deliveryRates             DeliveryRate[]
  deliveryCarrierRateCache  DeliveryCarrierRateCache[]
  deliveryAccounts          TenantDeliveryAccount[]
  storeSettings             StoreSettings?
  contactInfos              TenantContactInfo[]
  domains                   TenantDomain[]
  shipmentEvents            ShipmentEvent[]             @relation("TenantShipmentEvents")
  integrations              TenantIntegration[]
  metaPixels                TenantMetaPixel[]
  productMetaPixels         ProductMetaPixel[]
  maystroProductMaps        MaystroProductMapping[]
  maystroOrderMaps          MaystroOrderMapping[]
  maystroInventoryLogs      MaystroInventoryEvent[]
  licenses                  License[]
  devices                   Device[]
  activationRequests        DeviceActivationRequest[]
  migrationJobs             TenantMigrationJob[]
  notificationEvents        NotificationEvent[]
  notificationSubscriptions NotificationSubscription[]
  notificationDeliveries    NotificationDelivery[]
  blacklistEntries          BlacklistEntry[]
  idempotencyKeys           IdempotencyKey[]
}

model Cashbox {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  name     String
  isActive Boolean @default(true)

  defaultForStoreSettings StoreSettings[] @relation("StoreSettingsDefaultCashbox")
  users                   User[]          @relation("UserCashbox")

  sessions     CashSession[]
  transactions CashTransaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, name])
  @@unique([tenantId, id])
  @@index([tenantId])
}

model CashSession {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  cashboxId String
  cashbox   Cashbox @relation(fields: [tenantId, cashboxId], references: [tenantId, id], onDelete: Cascade)

  status String @default("OPEN") // OPEN | CLOSED

  openingFloat     Decimal  @default(0)
  closingCount     Decimal?
  closingCash      Decimal?
  closingCard      Decimal?
  closingTransfer  Decimal?
  closingOther     Decimal?
  expectedClosing  Decimal?
  expectedCash     Decimal?
  expectedCard     Decimal?
  expectedTransfer Decimal?
  expectedOther    Decimal?
  difference       Decimal?

  note String?

  openedAt DateTime  @default(now())
  closedAt DateTime?

  openedByUserId String?
  openedBy       User?   @relation("CashSessionOpenedBy", fields: [tenantId, openedByUserId], references: [tenantId, id])

  closedByUserId String?
  closedBy       User?   @relation("CashSessionClosedBy", fields: [tenantId, closedByUserId], references: [tenantId, id])

  transactions CashTransaction[]

  @@unique([tenantId, id])
  @@index([tenantId])
  @@index([tenantId, cashboxId])
  @@index([tenantId, cashboxId, status])
  @@index([tenantId, openedAt])
}

model CashTransaction {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  cashboxId String
  cashbox   Cashbox @relation(fields: [tenantId, cashboxId], references: [tenantId, id], onDelete: Cascade)

  sessionId String
  session   CashSession @relation(fields: [tenantId, sessionId], references: [tenantId, id], onDelete: Cascade)

  direction String // IN | OUT
  type      String // SALE_PAYMENT | CUSTOMER_PAYMENT | SUPPLIER_PAYMENT | EXPENSE | CHARGE | TRANSFER

  amount   Decimal
  currency String  @default("DZD")
  method   String  @default("CASH") // CASH | CARD | TRANSFER | OTHER

  customerId String?
  customer   Customer? @relation("CashTxCustomer", fields: [tenantId, customerId], references: [tenantId, id], onDelete: SetNull)

  supplierId String?
  supplier   Supplier? @relation("CashTxSupplier", fields: [tenantId, supplierId], references: [tenantId, id], onDelete: SetNull)

  saleId String?
  sale   Sale?   @relation("CashTxSale", fields: [tenantId, saleId], references: [tenantId, id], onDelete: SetNull)

  orderId String?
  order   Order?  @relation("CashTxOrder", fields: [tenantId, orderId], references: [tenantId, id], onDelete: SetNull)

  purchaseOrderId String?
  purchaseOrder   PurchaseOrder? @relation("CashTxPurchaseOrder", fields: [tenantId, purchaseOrderId], references: [tenantId, id], onDelete: SetNull)

  expenseCategory String?

  transferGroupId String?

  reference String?
  note      String?

  createdByUserId String?
  createdBy       User?   @relation("CashTransactionCreatedBy", fields: [tenantId, createdByUserId], references: [tenantId, id])

  createdAt DateTime @default(now())

  customerPayment CustomerPayment? @relation("CashTxCustomerPayment")
  supplierPayment SupplierPayment? @relation("CashTxSupplierPayment")

  @@unique([tenantId, id])
  @@index([tenantId])
  @@index([tenantId, cashboxId, createdAt])
  @@index([tenantId, sessionId, createdAt])
  @@index([tenantId, customerId])
  @@index([tenantId, supplierId])
  @@index([tenantId, saleId])
  @@index([tenantId, orderId])
  @@index([tenantId, purchaseOrderId])
  @@index([tenantId, transferGroupId])
}

model TenantSubscription {
  id       String @id @default(uuid())
  tenantId String @unique
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  planCode String // from shared pricing catalog (e.g. basic, merchant, professional)
  interval String @default("month") // month | year
  status   String @default("ACTIVE") // TRIALING | ACTIVE | CANCELED | PAST_DUE ...

  currentPeriodStart DateTime  @default(now())
  currentPeriodEnd   DateTime?
  trialEnd           DateTime?
  cancelAtPeriodEnd  Boolean   @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([planCode])
}

model BillingPayment {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  planCode String
  interval String @default("month") // month | year

  amountDzd Int
  currency  String @default("DA")

  method String @default("SIMULATED") // SIMULATED | MANUAL_PROOF | MYFIN | PAYSERA | BARIDIMOB | CCP | CHARGILY
  status String @default("PAID") // PAID | PENDING | REJECTED | IMPORTED

  proofUrl          String?
  notes             String?
  externalReference String?

  createdByUserId  String?
  reviewedByUserId String?

  periodStart DateTime?
  periodEnd   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([tenantId, createdAt])
  @@index([status])
}

model TenantDomain {
  id       String @id @default(uuid())
  domain   String @unique
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
}

model TenantIntegration {
  id       String  @id @default(uuid())
  tenantId String
  tenant   Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  provider String // TELEGRAM, FACEBOOK, TIKTOK, WHATSAPP, etc.
  config   Json? // Stores provider-specific settings, e.g. { botToken, chatId }
  isActive Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, provider])
  @@index([tenantId])
}

model TenantDeliveryAccount {
  id       String           @id @default(uuid())
  tenantId String
  tenant   Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  provider ShipmentProvider
  config   Json?
  isActive Boolean          @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, provider])
  @@index([tenantId])
}

model StoreSettings {
  id       String @id @default(uuid())
  tenantId String @unique
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  defaultCashboxId String?
  defaultCashbox   Cashbox? @relation("StoreSettingsDefaultCashbox", fields: [tenantId, defaultCashboxId], references: [tenantId, id], onDelete: SetNull)

  logoUrl       String? // URL of the tenant's store logo
  faviconUrl    String? // URL of the tenant's store favicon
  primaryColor  String  @default("#65A30D") // lime-600
  useBrandColor Boolean @default(false)
  templateKey   String  @default("modern") // e.g. classic | modern
  fontFamily    String  @default("Outfit")
  language      String  @default("fr") // ar | fr | en

  announcementText      String?
  announcementScrolling Boolean @default(false)

  // Merchant-facing "closed for maintenance" mode: blocks the public storefront
  // while leaving /admin reachable so the tenant can turn it back off.
  maintenanceMessage String?

  // Storefront legal/static pages content by language (FR/EN/AR)
  // and per-page visibility toggles for footer links.
  legalPages Json?

  // Storefront homepage configuration (carousel + sections).
  // Tenant-scoped via StoreSettings. Treated as an opaque JSON blob but validated at the API layer.
  homeConfig Json?

  cartEnabled           Boolean @default(true)
  codEnabled            Boolean @default(true)
  orderIdPrefix         String  @default("ORDR")
  minimumOrderAmountDzd Int     @default(1000)
  hideOptionalAddress   Boolean @default(true)
  currencyCode          String  @default("DZD") // ISO currency code
  currencyCountry       String  @default("DZ") // ISO country for flag/locale

  whatsappConfirmationTemplate String? // Customizable WhatsApp confirmation message template

  isCompleted              Boolean  @default(false)
  checklistDismissed       Boolean  @default(false)
  allowedDeliveryProviders String[] @default(["SELF"])
  storePickupEnabled       Boolean  @default(false)

  loyaltyEnabled               Boolean @default(false)
  loyaltyMinRedeemPoints       Int     @default(0)
  loyaltyRedeemRateDzdPerPoint Decimal @default(1)
  loyaltyBasePoints            Decimal @default(0)
  loyaltyMarginFactor          Decimal @default(0)
  loyaltyPublicFormulaMode     String  @default("SUMMARY")
  salesInvoiceEnabled          Boolean @default(false)
  invoiceNumberPrefix          String  @default("INV")
  invoiceFooterText            String?
  invoiceShowLogo              Boolean @default(true)

  // Clearance ("destockage") module settings
  clearanceEnabled       Boolean @default(false)
  clearanceMultiple      Int     @default(6)
  clearanceDivisor       Int     @default(3)
  clearanceBannerEnabled Boolean @default(false)
  clearanceBannerText    String?

  // Fraud prevention: blacklist enforcement + duplicate-order throttling at checkout
  blacklistEnabled           Boolean @default(true)
  duplicateOrderLimitEnabled Boolean @default(false)
  duplicateOrderLimit        Int     @default(3)
  duplicateOrderWindowHours  Int     @default(24)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TenantContactInfo {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  kind  String
  label String?
  value String

  position Int     @default(0)
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, id])
  @@index([tenantId])
  @@index([tenantId, kind])
  @@index([tenantId, position])
}

model User {
  id                 String           @id @default(uuid())
  email              String
  passwordHash       String?
  role               String           @default("staff") // owner, admin, staff
  isSuperAdmin       Boolean          @default(false)
  isActive           Boolean          @default(true)
  tokenInvalidBefore DateTime?
  tenantId           String
  tenant             Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  cashboxId          String?
  cashbox            Cashbox?         @relation("UserCashbox", fields: [tenantId, cashboxId], references: [tenantId, id], onDelete: SetNull)
  staffRoleId        String?
  staffRole          TenantStaffRole? @relation("StaffRoleUsers", fields: [tenantId, staffRoleId], references: [tenantId, id], onDelete: Restrict)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  inventoryMovements        InventoryMovement[]
  purchaseOrdersCreated     PurchaseOrder[]            @relation("PurchaseOrderCreatedBy")
  salesCreated              Sale[]                     @relation("SaleCreatedBy")
  salesInvoicesCreated      SalesInvoice[]             @relation("SalesInvoiceCreatedBy")
  customerPointsCreated     CustomerPointsLedger[]
  customerPaymentsCreated   CustomerPayment[]          @relation("CustomerPaymentCreatedBy")
  supplierPaymentsCreated   SupplierPayment[]          @relation("SupplierPaymentCreatedBy")
  cashSessionsOpened        CashSession[]              @relation("CashSessionOpenedBy")
  cashSessionsClosed        CashSession[]              @relation("CashSessionClosedBy")
  cashTransactionsCreated   CashTransaction[]          @relation("CashTransactionCreatedBy")
  notificationSubscriptions NotificationSubscription[]
  notificationDeliveries    NotificationDelivery[]
  blacklistEntriesCreated   BlacklistEntry[]

  @@unique([tenantId, email])
  @@unique([tenantId, id])
  @@index([tenantId])
  @@index([tenantId, isActive])
  @@index([tenantId, cashboxId])
  @@index([tenantId, staffRoleId])
}

model TenantStaffRole {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  name String

  permissions TenantStaffRolePermission[]
  users       User[]                      @relation("StaffRoleUsers")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, name])
  @@unique([tenantId, id])
  @@index([tenantId])
}

model TenantStaffRolePermission {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  roleId String
  role   TenantStaffRole @relation(fields: [tenantId, roleId], references: [tenantId, id], onDelete: Cascade)

  resource String
  action   String // create | read | update | delete

  createdAt DateTime @default(now())

  @@unique([tenantId, roleId, resource, action])
  @@index([tenantId])
  @@index([tenantId, roleId])
  @@index([tenantId, resource])
}

/// Controls whether a product or category appears in storefront listings,
/// navigation and search. UNLISTED entries stay reachable at their direct
/// slug URL but never show up in any browse surface.
enum Visibility {
  LISTED
  UNLISTED
}

model Category {
  id         String     @id @default(uuid())
  title      String
  slug       String
  imageUrl   String?
  visibility Visibility @default(LISTED)
  tenantId   String
  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  parentId String?
  parent   Category?  @relation("CategoryHierarchy", fields: [tenantId, parentId], references: [tenantId, id], onDelete: SetNull)
  children Category[] @relation("CategoryHierarchy")

  products     Product[]
  productLinks ProductCategory[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, slug])
  @@unique([tenantId, id])
  @@index([tenantId])
  @@index([tenantId, parentId])
  @@index([tenantId, visibility])
}

model Product {
  id                String  @id @default(uuid())
  title             String
  slug              String
  description       String?
  miniDescription   String?
  searchKeywords    String?
  price             Decimal @default(0)
  stock             Int     @default(0)
  lowStockThreshold Int     @default(5)

  // Promotion fields
  promotionalPrice   Decimal?
  isPromotionActive  Boolean   @default(false)
  promotionStartDate DateTime?
  promotionEndDate   DateTime?
  showCountdown      Boolean   @default(false)

  // Clearance ("destockage") module: tags this product as part of the tenant's clearance rule
  isClearance Boolean @default(false)

  isActive      Boolean        @default(true)
  visibility    Visibility     @default(LISTED)
  images        String[]       @default([]) // Deprecated: Use ProductImage model
  productImages ProductImage[]

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  categoryId    String?
  category      Category?         @relation(fields: [tenantId, categoryId], references: [tenantId, id])
  categoryLinks ProductCategory[]

  options     ProductOption[]
  variants    ProductVariant[]
  bundleDeals ProductBundleDeal[]

  orderItems      OrderItem[]
  saleItems       SaleItem[]
  maystroMappings MaystroProductMapping[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  metaPixels ProductMetaPixel[]

  @@unique([tenantId, slug])
  @@unique([tenantId, id])
  @@index([tenantId])
  @@index([tenantId, visibility])
}

model ProductCategory {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [tenantId, productId], references: [tenantId, id], onDelete: Cascade)

  categoryId String
  category   Category @relation(fields: [tenantId, categoryId], references: [tenantId, id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([tenantId, productId, categoryId])
  @@index([tenantId])
  @@index([tenantId, productId])
  @@index([tenantId, categoryId])
}

model TenantMetaPixel {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  name    String?
  pixelId String

  isActive Boolean @default(true)
  isGlobal Boolean @default(false)

  products ProductMetaPixel[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, pixelId])
  @@index([tenantId])
  @@index([tenantId, isGlobal])
}

model ProductMetaPixel {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [tenantId, productId], references: [tenantId, id], onDelete: Cascade)

  metaPixelId String
  metaPixel   TenantMetaPixel @relation(fields: [metaPixelId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([tenantId, productId, metaPixelId])
  @@index([tenantId])
  @@index([tenantId, productId])
  @@index([tenantId, metaPixelId])
}

model ProductBundleDeal {
  id        String  @id @default(uuid())
  tenantId  String
  tenant    Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [tenantId, productId], references: [tenantId, id], onDelete: Cascade)

  bundleQty   Int
  bundlePrice Decimal @default(0)
  tag         String?

  isActive Boolean   @default(true)
  startsAt DateTime?
  endsAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, productId, bundleQty])
  @@unique([tenantId, id])
  @@index([tenantId])
  @@index([tenantId, productId])
  @@index([tenantId, productId, isActive])
}

model ProductImage {
  id        String  @id @default(uuid())
  tenantId  String
  tenant    Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [tenantId, productId], references: [tenantId, id], onDelete: Cascade)
  url       String
  alt       String?
  position  Int     @default(0)
  isMain    Boolean @default(false)

  variants ProductVariantImage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, id])
  @@index([tenantId])
  @@index([tenantId, productId])
}

model ProductOption {
  id          String  @id @default(uuid())
  tenantId    String
  tenant      Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  productId   String
  product     Product @relation(fields: [tenantId, productId], references: [tenantId, id], onDelete: Cascade)
  name        String // e.g. "Color", "Size"
  position    Int     @default(0)
  displayType String  @default("dropdown") // dropdown, button, color, image

  values ProductOptionValue[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, id])
  @@index([tenantId])
  @@index([tenantId, productId])
}

model ProductOptionValue {
  id       String        @id @default(uuid())
  tenantId String
  tenant   Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  optionId String
  option   ProductOption @relation(fields: [tenantId, optionId], references: [tenantId, id], onDelete: Cascade)
  label    String // e.g. "Red", "XL"
  position Int           @default(0)
  meta     String? // JSON string for swatch colors, etc.

  variantValues ProductVariantOptionValue[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, id])
  @@index([tenantId])
  @@index([tenantId, optionId])
}

model ProductVariant {
  id        String  @id @default(uuid())
  tenantId  String
  tenant    Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [tenantId, productId], references: [tenantId, id], onDelete: Cascade)

  sku                String    @db.VarChar(32)
  skuLocked          Boolean   @default(false)
  barcode            String?   @db.VarChar(32)
  price              Decimal   @default(0)
  promotionalPrice   Decimal?
  isPromotionActive  Boolean   @default(false)
  promotionStartDate DateTime?
  promotionEndDate   DateTime?
  showCountdown      Boolean   @default(false)
  compareAtPrice     Decimal?
  cost               Decimal   @default(0) // prix d'achat (latest unit cost)
  isActive           Boolean   @default(true)

  // Inventory
  trackInventory Boolean @default(true)
  stock          Int     @default(0) // available
  reserved       Int     @default(0)
  safetyStock    Int     @default(0)

  optionValues       ProductVariantOptionValue[]
  images             ProductVariantImage[]
  movements          InventoryMovement[]
  purchaseOrderItems PurchaseOrderItem[]
  orderItems         OrderItem[]
  saleItems          SaleItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, sku])
  @@unique([tenantId, barcode])
  @@unique([tenantId, id])
  @@index([tenantId])
  @@index([tenantId, productId])
}

model ProductVariantOptionValue {
  tenantId      String
  tenant        Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  variantId     String
  variant       ProductVariant     @relation(fields: [tenantId, variantId], references: [tenantId, id], onDelete: Cascade)
  optionValueId String
  optionValue   ProductOptionValue @relation(fields: [tenantId, optionValueId], references: [tenantId, id], onDelete: Cascade)

  @@id([tenantId, variantId, optionValueId])
  @@index([tenantId])
  @@index([optionValueId])
}

model ProductVariantImage {
  tenantId  String
  tenant    Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  variantId String
  variant   ProductVariant @relation(fields: [tenantId, variantId], references: [tenantId, id], onDelete: Cascade)
  imageId   String
  image     ProductImage   @relation(fields: [tenantId, imageId], references: [tenantId, id], onDelete: Cascade)
  position  Int            @default(0)

  @@id([tenantId, variantId, imageId])
  @@index([tenantId])
  @@index([imageId])
}

model InventoryMovement {
  id               String                @id @default(uuid())
  tenantId         String
  tenant           Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  variantId        String
  variant          ProductVariant        @relation(fields: [tenantId, variantId], references: [tenantId, id], onDelete: Cascade)
  type             InventoryMovementType @default(MANUAL_ADJUSTMENT)
  delta            Int // stock delta
  reservedDelta    Int                   @default(0)
  safetyStockDelta Int                   @default(0)
  reason           String // e.g. "order", "restock", "correction"
  note             String?
  orderId          String?
  order            Order?                @relation(fields: [tenantId, orderId], references: [tenantId, id], onDelete: Cascade)
  saleId           String?
  sale             Sale?                 @relation(fields: [tenantId, saleId], references: [tenantId, id], onDelete: Cascade)

  stockAfter       Int?
  reservedAfter    Int?
  safetyStockAfter Int?

  createdByUserId String?
  createdBy       User?   @relation(fields: [tenantId, createdByUserId], references: [tenantId, id])

  createdAt DateTime @default(now())

  @@index([tenantId])
  @@index([variantId])
  @@index([tenantId, variantId, createdAt])
  @@index([tenantId, orderId])
  @@index([tenantId, saleId])
}

enum InventoryMovementType {
  MANUAL_ADJUSTMENT
  MANUAL_SET
  ORDER_DECREMENT
  PURCHASE_RECEIPT
  RESERVED_ADJUSTMENT
  SAFETY_STOCK_CHANGE
  TRACKING_CHANGE
}

model Sale {
