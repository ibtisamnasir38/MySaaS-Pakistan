  @@index([tenantId])
  @@index([tenantId, purchaseOrderId])
  @@index([tenantId, variantId])
}

model Order {
  id                      String  @id @default(uuid())
  publicId                String?
  tenantId                String
  tenant                  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  status                  String  @default("PENDING") // PENDING, CONFIRMED, SHIPPED, DELIVERED, CANCELLED
  paymentStatus           String  @default("UNPAID") // UNPAID | PARTIALLY_PAID | PAID
  totalAmount             Float
  totalWithShippingAmount Float?
  paidAmount              Float   @default(0)
  earnedPointsTotal       Int     @default(0)
  redeemedPointsTotal     Int     @default(0)
  redeemedAmount          Float   @default(0)
  clearanceDiscountAmount Float   @default(0)
  clearanceBreakdown      Json?

  customerId String?
  customer   Customer? @relation(fields: [tenantId, customerId], references: [tenantId, id], onDelete: SetNull)

  customerName            String
  customerPhone           String
  customerPhoneNormalized String?
  customerAddress         String?
  customerIp              String?

  callStatus    String    @default("not_called")
  internalNotes String?
  readAt        DateTime?

  deliveryMode         String            @default("home") // home | pickup | store
  shippingProvider     ShipmentProvider?
  shippingServiceLevel String?
  shippingAmount       Float?
  shippingCurrency     String            @default("DZD")
  shippingWilayaCode   String?
  shippingCommuneCode  String?
  shippingAddressLine1 String?
  shippingAddressLine2 String?
  shippingNotes        String?
  shippingEtaMinDays   Int?
  shippingEtaMaxDays   Int?
