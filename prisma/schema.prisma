/// Deliberately has no tenant FK: audit rows must outlive the tenant they
/// describe, so deleting a tenant cannot erase the record of what was done to it.
model AuditLog {
  id        String   @id @default(uuid())
  action    String
  details   String?
  userId    String? // ID of the user who performed the action (optional if system action)
  targetId  String? // ID of the target entity (e.g. tenantId)
  tenantId  String? // Tenant context usually null for super admin actions but good to have
  createdAt DateTime @default(now())

  @@index([tenantId, createdAt])
  @@index([action, createdAt])
  @@index([targetId])
}

model GoogleOAuthToken {
